{
  "name": "noodle-story-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Noodle Story — cozy Discord bot game",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "NODE_ENV=development nodemon --watch src --ext js,json --signal SIGTERM src/index.js",
    "check:actions-pinned": "bash scripts/check-actions-pinned.sh",
    "check:syntax": "find src test scripts -type f -name '*.js' -print0 | xargs -0 -n1 node --check",
    "check:pr-checklist": "node scripts/validate-pr-checklist.js --current-pr",
    "review:audit-gate": "node scripts/require-audit-complete.js",
    "review:one-command": "node scripts/review-one-command.js",
    "review:guard": "node scripts/pre-review-guard.js",
    "review:all": "npm run lint && npm test && npm run review:guard",
    "lint": "eslint src test scripts",
    "setup:hooks": "git config core.hooksPath .githooks",
    "register": "node src/register-commands.js",
    "register:dev": "NODE_ENV=development node src/register-commands.js",
    "register:prod": "NODE_ENV=production node src/register-commands.js",
    "test": "node --test",
    "test:no-sqlite": "node --test $(ls test/*.test.js | grep -v social.test.js)",
    "telemetry:v2-report": "node scripts/v2-efficiency-report.js",
    "sim": "node src/sim/runSimulation.js",
    "mobile:baseline": "bash scripts/mobile/cut-mobile-baseline.sh",
    "mobile:bootstrap": "bash scripts/mobile/bootstrap-mobile-repo.sh"
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.3",
    "better-sqlite3": "^11.3.0",
    "discord.js": "^13.17.1",
    "dotenv": "^17.4.2",
    "jose": "^6.2.3",
    "node-cron": "^4.5.0"
  },
  "overrides": {
    "undici": "^6.23.0"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "nodemon": "^3.1.14"
  }
}
